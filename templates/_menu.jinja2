{% macro render() %}

<div id="menu">

    <div class="view" id="view-load">
        <h5 class="title">
            Enter a <b>bus/tram/trolleybus route</b> relation ID
        </h5>
        <form class="body" id="load-relation-form">
            <input type="text" class="form-control mb-2" name="relation-id"
                value="{{ request.query_params.get('relation', '') }}" required>
            <button type="submit" class="btn btn-load btn-primary w-100">
                Load
            </button>
        </form>

        <div class="body pt-0">
            <div class="separator-or my-2"><span>or</span></div>
            <form id="create-relation-form">
                <div class="small mb-1">Create a <b>new route</b> from the visible area</div>
                <div class="input-group">
                    <select class="form-select" id="create-route-type" aria-label="Route type">
                        <option value="bus" selected>Bus</option>
                        <option value="tram">Tram</option>
                    </select>
                    <button type="submit" class="btn btn-create btn-outline-primary">
                        Create
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="view d-none" id="view-master">
        <h5 class="title">
            Route master
            <b>#<span class="master-id"></span></b>
            <a class="master-url" target="_blank">🔗</a>
        </h5>
        <div class="body">
            <div class="d-flex justify-content-between mb-2">
                <button class="btn btn-link btn-master-back p-0">« Change route</button>
                <button class="btn btn-link btn-master-reload p-0">↻ Reload</button>
            </div>

            <div id="master-summary"></div>

            <table class="table table-sm table-bordered table-tags mb-2 d-none" id="master-tags-table">
                <tbody id="master-tags"></tbody>
            </table>
            <div class="d-flex justify-content-between mb-2 d-none" id="master-tags-controls">
                <button type="button" class="btn btn-link btn-sm p-0" id="master-tags-toggle">Show all tags</button>
                <button type="button" class="btn btn-link btn-sm p-0" id="master-tags-add">+ Add tag</button>
            </div>
            <div class="mb-2 d-none" id="master-tags-actions">
                <label class="form-label small mb-1" for="master-comment">Changeset comment</label>
                <input type="text" class="form-control form-control-sm mb-1" id="master-comment" maxlength="255">
                <button class="btn btn-sm btn-primary w-100 mb-1" id="master-upload">Upload route master</button>
                <button class="btn btn-sm btn-secondary w-100" id="master-download">💾 Download .osc</button>
            </div>

            <div id="master-issues"></div>
            <div id="master-routes"></div>
        </div>
    </div>

    <div class="view d-none" id="view-edit">
        <h5 class="title">
            <span class="editing-label">Editing relation</span>
            <b>#<span class="relation-id"></span></b>
            <a class="relation-url" target="_blank">🔗</a>
        </h5>
        <div class="body">
            <div class="d-flex justify-content-between mb-2">
                <button class="btn btn-link btn-back p-0">« Change route</button>
                <button class="btn btn-link btn-reload p-0">↻ Reload</button>
            </div>

            <table class="table table-sm table-bordered table-tags mb-2">
                <tbody id="edit-tags"></tbody>
            </table>

            <div class="d-flex justify-content-between mb-2">
                <button type="button" class="btn btn-link btn-sm p-0" id="edit-tags-toggle">Show all tags</button>
                <button type="button" class="btn btn-link btn-sm p-0" id="edit-tags-add">+ Add tag</button>
            </div>

            <div class="d-flex align-items-center gap-2 mb-2">
                <label for="edit-driving-side" class="small text-nowrap"
                    title="Which side of the road buses drive on. A loop is driven the way that keeps its stops on that side.">Traffic keeps</label>
                <select class="form-select form-select-sm" id="edit-driving-side"></select>
            </div>

            <div class="d-none" id="edit-route-master"></div>

            <div class="d-none" id="edit-route-master-tags-wrap">
                <table class="table table-sm table-bordered table-tags mb-2">
                    <tbody id="edit-route-master-tags"></tbody>
                </table>
                <div class="d-flex justify-content-between mb-2">
                    <button type="button" class="btn btn-link btn-sm p-0"
                        id="edit-route-master-tags-toggle">Show all tags</button>
                    <button type="button" class="btn btn-link btn-sm p-0"
                        id="edit-route-master-tags-add">+ Add tag</button>
                </div>
            </div>

            <div id="edit-warnings"></div>

            <div class="actions text-end">
                <button class="btn btn-primary btn-next w-100 d-none">Finish editing</button>
            </div>
        </div>
    </div>

    <div class="view d-none" id="view-submit">
        <h5 class="title">
            Route summary
            <a class="relation-url" target="_blank">🔗</a>
        </h5>
        <div class="body">
            <button class="btn btn-link btn-back p-0 mb-2">« Go back</button>

            <div class="alert alert-light text-center small py-1 px-2 mb-2">
                Clicking on the stops doesn't do anything.<br>
                It's just to help you check the route.
            </div>

            <div id="route-summary"></div>

            <div class="mb-2">
                <label class="form-label small mb-1" for="submit-comment">Changeset comment</label>
                <input type="text" class="form-control form-control-sm" id="submit-comment" maxlength="255">
            </div>

            <div class="actions">
                <div class="mb-1">
                    <button class="btn btn-primary btn-upload w-100">
                        <img src="/static/img/brands/openstreetmap.webp" class="icon" alt="OpenStreetMap logo"
                            height="22">
                        Upload to OSM
                    </button>
                </div>
                <div>
                    <button class="btn btn-sm btn-secondary btn-download w-100">💾 Download .osc</button>
                </div>
            </div>
        </div>
    </div>

</div>

{% endmacro %}
