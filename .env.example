# Register an OAuth 2 application at
# https://www.openstreetmap.org/oauth2/applications with the scopes
# "read_prefs" and "write_api", and a redirect URI of
# http://localhost:8000/callback for local development.
OSM_CLIENT=
OSM_SECRET=

# To test uploads without touching live data, point this at the dev server and use an
# OAuth application registered there instead. Map data still comes from live OSM.
# OSM_URL=https://master.apis.dev.openstreetmap.org

# NaPTAN stop suggestions and checks are on by default, and download the national
# dataset, about 100 MB, into ./data. NaPTAN covers Great Britain only; elsewhere, turn
# them off to skip the download.
# NAPTAN_ENABLED=0
